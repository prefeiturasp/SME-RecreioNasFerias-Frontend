VITE_API_BASE_URL=
# URL base do backend do Recreio nas Férias.
# Em desenvolvimento local, deixe vazio para usar o proxy do Vite (/api → localhost:8000).
# No container Docker, informe na subida do container (runtime).

VITE_SME_INTEGRACAO_API_BASE_URL=
# URL base da API SME Integração.
# Em desenvolvimento local, deixe vazio para usar o proxy do Vite (/sme-integracao-api).
# No container Docker, informe na subida do container (runtime).

VITE_SME_INTEGRACAO_API_KEY=
# Chave enviada no header x-api-eol-key nas chamadas à SME Integração.
# No container Docker, informe na subida do container (runtime).
