VITE_API_BASE_URL=
# URL base do backend do Recreio nas Férias (usada pelo proxy do Nginx em /api/).
# Em desenvolvimento local, deixe vazio: o proxy do Vite encaminha /api para localhost:8000.
# No container Docker, informe na subida do container (runtime).

VITE_SME_INTEGRACAO_API_BASE_URL=
# URL base da API SME Integração (usada pelo proxy do Nginx em /sme-integracao-api/).
# Em desenvolvimento local, deixe vazio: o proxy do Vite encaminha /sme-integracao-api.
# No container Docker, informe na subida do container (runtime).

VITE_SME_INTEGRACAO_API_KEY=
# Chave enviada no header x-api-eol-key nas chamadas à SME Integração.
# No container Docker, informe na subida do container (runtime).
